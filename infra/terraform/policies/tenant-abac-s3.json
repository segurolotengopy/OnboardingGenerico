{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TenantObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::og-ENV-documents-SUFFIX/${aws:PrincipalTag/TenantID}/*",
        "arn:aws:s3:::og-ENV-biometrics-SUFFIX/${aws:PrincipalTag/TenantID}/*",
        "arn:aws:s3:::og-ENV-staging-SUFFIX/${aws:PrincipalTag/TenantID}/*"
      ]
    },
    {
      "Sid": "TenantScopedList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::og-ENV-documents-SUFFIX",
        "arn:aws:s3:::og-ENV-biometrics-SUFFIX",
        "arn:aws:s3:::og-ENV-staging-SUFFIX"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "${aws:PrincipalTag/TenantID}/*"
          ]
        }
      }
    },
    {
      "Sid": "WriteOnlyAuditEvidence",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectRetention"
      ],
      "Resource": [
        "arn:aws:s3:::og-ENV-evidence-SUFFIX/${aws:PrincipalTag/TenantID}/*"
      ]
    },
    {
      "Sid": "TenantScopedKmsUsage",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey"
      ],
      "Resource": [
        "arn:aws:kms:REGION:ACCOUNT_ID:key/TENANT_CMK_KEY_ID"
      ],
      "Condition": {
        "StringEquals": {
          "kms:EncryptionContext:tenant": "${aws:PrincipalTag/TenantID}"
        }
      }
    },
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": "*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    }
  ]
}
