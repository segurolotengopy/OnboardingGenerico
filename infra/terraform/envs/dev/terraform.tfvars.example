# ---------------------------------------------------------------------------
# Ejemplo de valores para el entorno dev.
#
# Copie este archivo a terraform.tfvars y sustituya los marcadores. NINGUN valor
# real ni secreto debe versionarse: terraform.tfvars esta (o debe estar) en
# .gitignore. Los secretos de verdad no van aqui en absoluto: van a Secrets
# Manager o Secret Manager y se referencian por nombre.
# ---------------------------------------------------------------------------

cloud_provider = "aws" # aws | gcp | both
env            = "dev"
owner          = "REEMPLAZAR-equipo-plataforma"
cost_center    = "REEMPLAZAR-CC-0000"

tenants = {
  "acme" = {
    tier         = "premium"
    jurisdiction = "MX"
  }
  "globex" = {
    tier         = "standard"
    jurisdiction = "PY"
  }
}

alarm_email_subscriptions = {
  plataforma = "REEMPLAZAR@example.invalid"
}

# --- AWS -------------------------------------------------------------------

aws_region = "us-east-1"

aws_private_subnets = {
  "us-east-1a" = "10.60.1.0/24"
  "us-east-1b" = "10.60.2.0/24"
}

key_administrator_arns = [
  # "arn:aws:iam::000000000000:role/REEMPLAZAR-security-admin",
]

aws_artifacts_bucket_name = "REEMPLAZAR-og-artifacts-dev"

aws_zip_functions = {
  "pre-token-generation" = {
    description = "Inyecta el tenant como principal tag. Falla cerrado si no hay tenant."
    handler     = "onboarding_generico.adapters.aws.pre_token_generation.handler"
    s3_key      = "lambdas/pre-token-generation-v1.zip"
    memory_mb   = 256
    timeout_seconds = 5
  }
  "authorizer" = {
    description = "Autorizador delgado que delega en la logica del nucleo."
    handler     = "onboarding_generico.adapters.aws.authorizer.handler"
    s3_key      = "lambdas/authorizer-v1.zip"
    memory_mb   = 512
    timeout_seconds = 10
  }
  "api" = {
    description = "API de consulta y administracion."
    handler     = "onboarding_generico.adapters.aws.api.handler"
    s3_key      = "lambdas/api-v1.zip"
    memory_mb   = 1024
  }
  "plan-resolver" = {
    description = "Resuelve el plan de pasos contra el Registro de Capacidades."
    handler     = "onboarding_generico.adapters.aws.plan_resolver.handler"
    s3_key      = "lambdas/plan-resolver-v1.zip"
  }
  "risk-scoring" = {
    description = "Calcula el puntaje de riesgo y propone decision."
    handler     = "onboarding_generico.adapters.aws.risk_scoring.handler"
    s3_key      = "lambdas/risk-scoring-v1.zip"
  }
  "human-review-dispatch" = {
    description = "Publica el caso en la cola de revision con el task token."
    handler     = "onboarding_generico.adapters.aws.human_review.handler"
    s3_key      = "lambdas/human-review-dispatch-v1.zip"
  }
  "decision-recorder" = {
    description = "Persiste la decision y escribe la evidencia WORM."
    handler     = "onboarding_generico.adapters.aws.decision_recorder.handler"
    s3_key      = "lambdas/decision-recorder-v1.zip"
  }
  "gdpr-purge" = {
    description = "Purga de datos personales sobre el stream de la tabla core."
    handler     = "onboarding_generico.adapters.aws.gdpr_purge.handler"
    s3_key      = "lambdas/gdpr-purge-v1.zip"
    memory_mb   = 1024
    timeout_seconds = 900
  }
  "liveness" = {
    description = "Consulta el resultado de la sesion de vivacidad del proveedor."
    handler     = "onboarding_generico.adapters.aws.liveness.handler"
    s3_key      = "lambdas/liveness-v1.zip"
    timeout_seconds = 60
  }
}

aws_container_functions = {
  "preprocess" = {
    description     = "Normalizacion de imagen: recorte, perspectiva y control de calidad."
    image_tag       = "v1"
    architecture    = "x86_64" # requiere AVX2 en las dependencias nativas
    timeout_seconds = 120
  }
  "ocr" = {
    description     = "OCR generico del documento."
    image_tag       = "v1"
    timeout_seconds = 180
  }
  "field-extraction" = {
    description     = "Extraccion estructurada de campos con modelo multimodal, por pais y tipo de documento."
    image_tag       = "v1"
    timeout_seconds = 240
  }
  "face-match" = {
    description     = "Embeddings faciales y similitud coseno con ONNX Runtime."
    image_tag       = "v1"
    architecture    = "x86_64"
    timeout_seconds = 60
    # memory_mb se deja nulo para heredar inference_memory_mb del entorno.
  }
}

aws_tenant_usage_plans = {
  "acme" = {
    tier        = "premium"
    rate_limit  = 50
    burst_limit = 100
  }
  "globex" = {
    tier        = "standard"
    rate_limit  = 10
    burst_limit = 20
  }
}

# --- GCP (solo si cloud_provider incluye gcp) -------------------------------

gcp_project_id         = "REEMPLAZAR-og-dev"
gcp_region             = "us-central1"
gcp_firestore_location = "nam5"
gcp_storage_location   = "US"

gcp_oidc_issuer_uri = "https://REEMPLAZAR.example.invalid"
gcp_oidc_audience   = "onboarding-generico"
gcp_jwks_uri        = "https://REEMPLAZAR.example.invalid/.well-known/jwks.json"

gcp_image_names = ["composer", "extraction", "biometrics", "review", "gdpr-purge"]

gcp_services = {
  composer = {
    description   = "Nucleo hexagonal: plan, scoring, decisiones y autorizacion in-process."
    image_name    = "composer"
    cpu           = "1"
    memory        = "2Gi"
    concurrency   = 80
    min_instances = 0
    max_instances = 10
  }
  extraction = {
    description     = "OCR generico y extraccion estructurada por LLM."
    image_name      = "extraction"
    cpu             = "2"
    memory          = "4Gi"
    concurrency     = 8
    timeout_seconds = 540
  }
  biometrics = {
    description          = "Face match con ONNX Runtime."
    image_name           = "biometrics"
    cpu                  = "4"
    memory               = "8Gi"
    concurrency          = 2 # concurrencia alta satura la CPU con ONNX
    always_allocated_cpu = true
    timeout_seconds      = 120
  }
  review = {
    description = "Cola y consola de revision manual."
    image_name  = "review"
    cpu         = "1"
    memory      = "1Gi"
    concurrency = 40
  }
}

gcp_jobs = {}
