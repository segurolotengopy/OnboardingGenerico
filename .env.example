# =============================================================================
# Onboarding Genérico — variables de entorno de ejemplo
# =============================================================================
# Copie este archivo a .env y complete los valores. NUNCA versione el .env real.
# Todos los valores de este archivo son ficticios.

# --- Selección de nube -------------------------------------------------------
# aws | gcp | inmemory  (inmemory es el valor de desarrollo local)
OG_CLOUD_PROVIDER=inmemory
OG_ENVIRONMENT=dev
OG_LOG_LEVEL=INFO
# Redacta PII en los registros. Desactivarlo en producción es una violación de política.
OG_REDACT_PII=true

# --- AWS ---------------------------------------------------------------------
AWS_REGION=us-east-1
OG_AWS_TABLE_NAME=og-dev-core
OG_AWS_KEYSTORE_TABLE=og-dev-keystore
OG_AWS_CAPABILITY_TABLE=og-dev-capabilities
OG_AWS_DOCUMENTS_BUCKET=og-dev-documents-000000000000
OG_AWS_EVIDENCE_BUCKET=og-dev-evidence-000000000000
OG_AWS_STATE_MACHINE_ARN=arn:aws:states:us-east-1:000000000000:stateMachine:og-dev-onboarding
OG_AWS_PLATFORM_KEY_ARN=arn:aws:kms:us-east-1:000000000000:key/00000000-0000-0000-0000-000000000000
OG_AWS_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
OG_AWS_TENANT_ROLE_ARN=arn:aws:iam::000000000000:role/og-dev-tenant-scoped

# --- GCP ---------------------------------------------------------------------
OG_GCP_PROJECT=mi-proyecto-ejemplo
OG_GCP_LOCATION=us-central1
OG_GCP_FIRESTORE_DATABASE=og-dev
OG_GCP_DOCUMENTS_BUCKET=og-dev-documents
OG_GCP_EVIDENCE_BUCKET=og-dev-evidence
OG_GCP_WORKFLOW_NAME=og-dev-onboarding
OG_GCP_KEYRING=og-dev
GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/su/service-account.json

# --- Modelos de lenguaje -----------------------------------------------------
# En AWS: identificador de modelo de Amazon Bedrock. En GCP: modelo en la plataforma de agentes.
OG_LLM_MODEL_ID=anthropic.claude-sonnet-4-5-v1:0
OG_LLM_PROMPT_CACHE_ENABLED=true
# Umbral de confianza por debajo del cual la transacción se deriva a revisión humana (0.0–1.0)
OG_DECISION_CONFIDENCE_THRESHOLD=0.85

# --- Biometría ---------------------------------------------------------------
# Umbral de similitud para el emparejamiento facial 1:1. Debe calibrarse contra la
# población real midiendo FMR/FNMR; el valor por defecto NO es una recomendación.
OG_FACE_MATCH_THRESHOLD=0.40
# Proveedor de liveness certificado (ver ADR-0009). Ningún valor por defecto a propósito.
OG_LIVENESS_PROVIDER=
OG_LIVENESS_API_BASE_URL=
# El secreto se resuelve por el gestor de secretos, nunca por variable de entorno en producción.
OG_LIVENESS_SECRET_REF=projects/mi-proyecto-ejemplo/secrets/liveness-api-key/versions/latest

# --- Retención ---------------------------------------------------------------
# El plazo lo fija el responsable del tratamiento (cliente B2B) en el contrato.
# El middleware lo implementa; no lo elige. Ver docs/12-retencion-y-borrado.md
OG_SESSION_TTL_SECONDS=1800
OG_EVIDENCE_RETENTION_DAYS=1825
